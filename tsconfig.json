{
  "compilerOptions": {
    "baseUrl": "src",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "components/*": [
        "components/*"
      ],
      "layout/*": [
        "layout/*"
      ]
    }
  },
  "include": [
    "src",
    "declarations.d.ts"
  ]
}